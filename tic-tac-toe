board = [" "] * 9
player = "X"

while True:
    print(board[0], "|", board[1], "|", board[2])
    print("--+---+--")
    print(board[3], "|", board[4], "|", board[5])
    print("--+---+--")
    print(board[6], "|", board[7], "|", board[8])

    p = int(input("Player " + player + ", enter position (1-9): ")) - 1

    if board[p] != " ":
        print("Already taken!")
        continue

    board[p] = player

    w = [
        (0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)
    ]

    for a, b, c in w:
        if board[a] == board[b] == board[c] != " ":
            print("Player", player, "wins!")
            exit()

    if " " not in board:
        print("Draw!")
        break

    player = "O" if player == "X" else "X"
